# Configuration Aikido (lue à chaque scan, y compris les contrôles de PR).
# Les chemins sont comparés par sous-chaîne du chemin complet : pas de jokers,
# donc chaque entrée doit être assez précise pour ne rien capturer d'autre.
# Une exclusion retire aussi le fichier du scan de secrets (Gitleaks, dans
# ci-security, couvre toujours ces fichiers).
exclude:
  paths:
    # Outillage de build et de release, local ou CI, jamais livré dans l'app :
    # les règles de path traversal et de SSRF y sont des faux positifs sur des
    # arguments de confiance (chemins déjà résolus et contenus, URL fixes).
    - scripts/desktop-release-provenance.mjs
    - scripts/notarize-dmg.mjs
    - scripts/publish-syntheo-skill.mjs
    - scripts/rebrand.mjs
    - scripts/release-version.mjs
    - scripts/repack-linux-appimage.mjs
    - scripts/update-aur-pkgbuild.mjs
    - scripts/remediation/
