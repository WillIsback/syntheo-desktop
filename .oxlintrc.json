{
  "ignorePatterns": ["**/*.gen.ts"],
  "plugins": ["promise"],
  "jsPlugins": ["./eslint-plugin-syntheo.mjs"],
  "rules": {
    "syntheo/await-tauri-commands": "warn",
    "syntheo/no-raw-tinybase": "off"
  },
  "overrides": [
    {
      "files": ["**/*.{ts,tsx}"],
      "plugins": ["typescript"]
    },
    {
      "files": ["apps/desktop/src/**/*.{ts,tsx}"],
      "plugins": ["react", "react-perf"]
    },
    {
      "files": ["apps/desktop/src/**/*.{ts,tsx}"],
      "rules": {
        "syntheo/no-raw-tinybase": "error"
      }
    }
  ]
}
